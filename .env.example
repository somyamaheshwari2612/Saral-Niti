# ==============================================================================
# Saral Niti - Environment Configuration Template
# Copy this file to backend/.env and add your Gemini API key.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Google Gemini API Key (Required for AI Scheme & URL Fraud Detector)
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
# Model: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Local SQLite Database Path (Optional, defaults to data/schemes.db)
# Auto-created and auto-seeded from data/schemes.json on first run.
# SQLITE_DB_PATH=data/schemes.db

# Flask Server Configuration (Optional)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Frontend URL for CORS Locking (Deploy on Vercel)
# Set this to your actual Vercel domain in production, e.g., https://saral-niti.vercel.app
FRONTEND_URL=https://your-domain.vercel.app
