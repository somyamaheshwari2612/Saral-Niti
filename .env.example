# ==============================================================================
# Saral Niti - Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# MongoDB Connection String (Atlas or Local)
# Example (Atlas): mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/saral_niti_db?retryWrites=true&w=majority
# Example (Local): mongodb://localhost:27017/saral_niti_db
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/saral_niti_db?retryWrites=true&w=majority

# Google Gemini API Key (Used for AI Scheme/URL Scam Detector)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-2.5-flash-lite)
# Options: gemini-2.5-flash-lite, gemini-2.0-flash-lite, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# Flask Server Configuration (Optional)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
